{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "simple",
      "include-v-in-tag": true,
      "changelog-sections": [
        {"type": "feat",     "section": "Nuevas funcionalidades", "hidden": false},
        {"type": "fix",      "section": "Correcciones",           "hidden": false},
        {"type": "perf",     "section": "Rendimiento",            "hidden": false},
        {"type": "docs",     "section": "Documentación",          "hidden": false},
        {"type": "refactor", "section": "Refactor",               "hidden": false},
        {"type": "chore",    "section": "Otros",                  "hidden": true},
        {"type": "ci",       "section": "Otros",                  "hidden": true}
      ],
      "extra-files": [
        {
          "type": "generic",
          "path": "version.php"
        }
      ]
    }
  }
}
